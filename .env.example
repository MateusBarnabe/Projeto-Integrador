# Variáveis do docker-compose.yml. Copie para .env só se quiser mudar algum padrão.

# Postgres
# POSTGRES_USUARIO=postgres
# POSTGRES_SENHA=postgres
# POSTGRES_PORTA=5432
# MARKETING_OWNER_SENHA=own_marketing
# MARKETING_APP_SENHA=usr_marketing

# RabbitMQ (painel em http://localhost:15672, admin/admin)
# RABBITMQ_PORTA=5672
# RABBITMQ_PAINEL_PORTA=15672

# Mailpit (e-mails enviados em http://localhost:8025)
# MAILPIT_SMTP_PORTA=1025
# MAILPIT_PAINEL_PORTA=8025

# JWKS do identity, que roda pelo compose do infra-integrador-2026
# IDENTITY_JWKS_URI=http://host.docker.internal:8081/.well-known/jwks.json
