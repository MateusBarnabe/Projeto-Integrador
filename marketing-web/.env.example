# Copie para .env.local e ajuste. Nada aqui é obrigatório para rodar local.

# Caminho base do módulo (padrão: /modulos/marketing/)
# VITE_BASE_PATH=/modulos/marketing/

# Endereço da API (padrão: /api/marketing, relativo, pelo proxy do Vite ou pelo gateway)
# VITE_API_URL=/api/marketing

# Para onde o proxy do Vite manda /api/marketing em desenvolvimento (padrão: http://localhost:8087)
# API_PROXY_ALVO=http://localhost:8087

# Token real de um usuário de teste do identity, para o modo sozinho
# VITE_TOKEN_DEV=
