{
  "name": "landing-web",
  "private": true,
  "version": "0.1.0",
  "description": "Placeholder do módulo Landing (Grupo 7): landing page e formulário público, para testar a jornada do lead localmente",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n front,server -c cyan,magenta \"npm:dev:front\" \"npm:dev:server\"",
    "dev:front": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}
